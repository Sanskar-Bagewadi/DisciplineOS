{
  "expo": {
    "name": "DisciplineOS",
    "slug": "DisciplineOS",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/images/icon-v1.png",
    "scheme": "disciplineos",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#0B0B0B",
        "foregroundImage": "./assets/images/icon-v1.png",
        "backgroundImage": "./assets/images/icon-v1.png",
        "monochromeImage": "./assets/images/icon-v1.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.sanskarbagewadi.disciplineos"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon-v1.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0B0B0B",
          "dark": {
            "backgroundColor": "#0B0B0B"
          }
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e2025a35-602b-4e6c-97c9-c0a73d64744c"
      }
    }
  }
}
